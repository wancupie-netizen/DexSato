# ==========================================================
# DexSato Founder V1 Configuration
# ==========================================================

# Runtime mode: use production only in the deployed environment.
DEXSATO_ENV=development

# Railway injects PORT automatically. Production HOST should remain 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# Maximum accepted HTTP request body. Default: 16 KiB; hard maximum: 1 MiB.
DEXSATO_MAX_REQUEST_BYTES=16384

# Maximum active buckets for local/test in-memory rate limiting only.
DEXSATO_RATE_LIMIT_MAX_BUCKETS=10000

# Shared rate-limit coordination.
# Local/tests: memory. Production: redis (validated fail-closed at startup).
DEXSATO_RATE_LIMIT_STORE=memory

# Development may leave this empty to use output/research/solana-discovery-phase0-seven-day.
# Production requires an absolute path mounted on persistent storage, e.g. /data/dexsato-discovery.
DEXSATO_DISCOVERY_STORAGE_DIR=

# Optional one-shot discovery collector supervisor. Keep disabled by default;
# enable only on the single staging pod that owns the persistent volume.
DEXSATO_COLLECTOR_ENABLED=false
DEXSATO_COLLECTOR_INTERVAL_SECONDS=900
DEXSATO_COLLECTOR_TIMEOUT_SECONDS=600
DEXSATO_COLLECTOR_LIMIT=20
DEXSATO_DISCOVERY_STALE_MINUTES=45

# Keep one web worker during initial staging. TW-SEC-009 and TW-SEC-011 move
# Jupiter pending state and rate limiting to Redis; scale only after final regression/abuse tests.
DEXSATO_WEB_WORKERS=1

# Jupiter pending-order coordination.
# Local/tests: memory. Production: redis (validated fail-closed at startup).
DEXSATO_PENDING_STORE=memory
REDIS_URL=

# Required server-side provider credentials in production. Never expose to JavaScript.
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# Phase 03-C: keep disabled until Phase 03-D UI and on-chain validation pass.
# Public Ultra referral address supplied by the owner; NOT proof of on-chain verification.
DEXSATO_JUPITER_FEE_ENABLED=false
DEXSATO_JUPITER_REFERRAL_ACCOUNT=5q9Rk7oLhpxyoUstjKqbJxV3xnAi7Zucqsuw6NCzzNQQ
DEXSATO_JUPITER_REFERRAL_FEE_BPS=50
# Continuous public execution stays fail-closed until explicitly enabled.
# Never enable this together with DEXSATO_JUPITER_ONE_SHOT_MODE.
DEXSATO_JUPITER_LIVE_FEE_EXECUTION_ENABLED=false
DEXSATO_JUPITER_ONE_SHOT_MODE=false
DEXSATO_JUPITER_ONE_SHOT_GATE_PATH=
# Full PUBLIC wallet address that owns the Ultra referral (partner field).
# Required for read-only referral verification; never enter a private key/seed.
DEXSATO_JUPITER_REFERRAL_PARTNER=

# Optional replacement for the reviewed Solana mainnet RPC endpoint. HTTPS only.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Internal legacy operations are disabled by default in production.
# Enable only when required and protect them with a random 32+ character token.
DEXSATO_INTERNAL_ENDPOINTS_ENABLED=false
DEXSATO_OPERATOR_TOKEN=

# Comma-separated hostnames only; do not include https:// or paths.
# Railway: add the generated Railway hostname. Add dexsato.com during Phase 06.
DEXSATO_ALLOWED_HOSTS=127.0.0.1,localhost

# Enable only when every public request reaches DexSato through a trusted
# reverse proxy/load balancer that appends the real source address to
# X-Forwarded-For. Leave false for direct/local access.
DEXSATO_TRUST_PROXY_HEADERS=false

# Metadata-only application logging. DEBUG is rejected in production.
DEXSATO_LOG_LEVEL=INFO

# Optional full replacement for the reviewed built-in top-level Solana program allowlist.
# Leave empty unless an actual Jupiter transaction is rejected and the program is verified.
DEXSATO_ALLOWED_SWAP_PROGRAMS=

# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service or API key.
# Never commit your real key.
SUPABASE_KEY=your-supabase-key

# Twelve Data key for the XAU/USD and XAG/USD reference feed.
# Never commit your real key.
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Telegram Bot API token generated through BotFather.
# Never commit your real token.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram user or group chat ID.
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Leave empty while the dashboard is available only locally.
# Add a public HTTPS URL after DexSato is deployed.
PUBLIC_DASHBOARD_URL=

# Windows Task Scheduler uses the computer's local time.
SCAN_TIME_1=08:00
SCAN_TIME_2=14:00
SCAN_TIME_3=20:00

# ==========================================================
# Founder-only Content Control Center
# ==========================================================

# Strong private password used only for /content-control.
# Never commit your real password.
CONTENT_CONTROL_PASSWORD=replace-with-a-strong-private-password

# Long random signing secret for the 12-hour founder session cookie.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTENT_CONTROL_SESSION_SECRET=replace-with-a-long-random-secret

# Optional AI writing layer. If empty, Content Control Center uses a
# deterministic fallback draft and the DexSato engine is still untouched.
OPENAI_API_KEY=

# Server-side writing model. This affects wording only, never DexSato decisions.
CONTENT_CONTROL_AI_MODEL=gpt-5.6
# ClaimV2 one-shot wallet approval boundary. Keep disabled outside a separately
# approved controlled claim window. This gate never enables submission itself.
DEXSATO_JUPITER_CLAIM_GATE_ENABLED=false
DEXSATO_JUPITER_CLAIM_GATE_PATH=
# F.6A remains disabled pending a separately audited live-approval boundary.
DEXSATO_JUPITER_CLAIM_SUBMISSION_ENABLED=false

# Separate F.6B approval transition. Never enable this and submission together.
DEXSATO_JUPITER_CLAIM_LIVE_APPROVAL_ENABLED=false
# F.6C uses the existing submission flag only inside a supervised one-shot window.

